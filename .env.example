# Django
DJANGO_SECRET_KEY=change-me-in-production-please-generate-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Sesión: duración en segundos (default 8 h). Cookies "secure" activas fuera de
# DEBUG; usar DJANGO_SECURE_COOKIES=0 solo si el despliegue no tiene TLS.
DJANGO_SESSION_COOKIE_AGE=28800
# DJANGO_SECURE_COOKIES=1

# Correo para password reset (en dev se imprime en la consola del backend)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=atalaya@localhost

# Cifrado de campos (tokens de registry). OBLIGATORIA: Atalaya no arranca sin ella.
# Lista separada por comas; la primera cifra y todas descifran (rotación).
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotar: anteponer una llave nueva, ejecutar `manage.py rotate_field_encryption`, retirar la vieja.
ATALAYA_FIELD_ENCRYPTION_KEYS=

# Redis (broker de Celery y caché). En Docker Compose lo fija el compose; para
# desarrollo fuera de Docker sin Redis, dejar vacío: caché en memoria y Celery en memoria.
# REDIS_URL=redis://redis:6379/0
# Ejecutar tareas en el mismo proceso (solo depuración):
# CELERY_TASK_ALWAYS_EAGER=1

# Inventario de activos
ATALAYA_ASSET_STALE_DAYS=14
ATALAYA_MAX_DISCOVERY_PREFIX=16
ATALAYA_SBOM_MAX_MB=50

# PostgreSQL
POSTGRES_DB=atalaya
POSTGRES_USER=atalaya
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ======================================================================
# LLM local (Ollama en Docker Compose)
# ----------------------------------------------------------------------
# Ollama corre como servicio "ollama" (sin puertos publicados). scripts/compose.sh
# detecta una GPU NVIDIA y la habilita; sin GPU funciona en CPU (más lento: las
# inferencias corren en segundo plano y la UI se actualiza sola al terminar).
# Para usar un Ollama externo (p. ej. en el host): OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_DEFAULT_MODEL=qwen2.5:7b-instruct-q4_K_M
# Modelos que se pueden elegir en la UI y evaluar (eje 2 de la tesis).
LLM_AVAILABLE_MODELS=llama3.1:8b-instruct-q4_K_M,mistral:7b-instruct-q4_K_M,qwen2.5:7b-instruct-q4_K_M
# Timeout por inferencia: con GPU / con CPU (se elige según el acelerador detectado).
LLM_TIMEOUT_S=180
LLM_TIMEOUT_CPU_S=900
LLM_RATE_LIMIT_PER_MIN=30

# ======================================================================
# CTI (Módulo 3): espejo local de NVD, EPSS y CISA KEV
# ----------------------------------------------------------------------
# Las fuentes se descargan HACIA Atalaya (Beat, cada hora revisa qué fuente venció su
# intervalo; Administración › Detección › Fuentes CTI permite cambiar URL e intervalo).
# Sin NVD_API_KEY, NVD limita a 5 peticiones por 30 s (la sincronización es más lenta).
NVD_API_KEY=
EPSS_SNAPSHOT_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
# Primera sincronización incremental de NVD: días hacia atrás.
CTI_NVD_INITIAL_DAYS=30
# Espejo dirigido: cada cuántos días se vuelven a traer los CVE de un producto del inventario.
CTI_PRODUCT_REFRESH_DAYS=7
# «EPSS subió»: incremento mínimo entre snapshots, o primer puntaje >= CTI_EPSS_HIGH.
CTI_EPSS_RISE_DELTA=0.1
CTI_EPSS_HIGH=0.5
# CTI_ONLINE=0 impide cualquier descarga (entornos sin salida a internet: usar load_cti_fixture).
CTI_ONLINE=1

# Detección continua (Módulo 3): «pasó mucho sin revisar».
DETECTION_ASSET_REVIEW_DAYS=14
DETECTION_FINDING_REVIEW_DAYS=30
# Tope de decisiones del planificador (LLM) por hora mientras no haya configuración en BD.
DETECTION_PLANNER_MAX_PER_HOUR=60

# Scanners
NMAP_BIN=/usr/bin/nmap
NUCLEI_BIN=/usr/local/bin/nuclei
GRYPE_BIN=/usr/local/bin/grype
SCAN_RESULTS_DIR=/data/scan-results

# Scoring weights (ajustables experimentalmente)
SCORING_WEIGHT_CVSS=0.30
SCORING_WEIGHT_EPSS=0.25
SCORING_WEIGHT_KEV=0.20
SCORING_WEIGHT_ASSET_CRITICALITY=0.15
SCORING_WEIGHT_EXPOSURE=0.10

# ======================================================================
# DEV: modo simulado del LLM (sin llamar a Ollama)
# Si está en 1, el cliente devuelve JSON válido y determinista (marcado como "mock"
# en InferenceLog). Útil para desarrollar la UI sin descargar modelos.
# ======================================================================
LLM_MOCK_MODE=0
