# ==============================================================================
# vulnlab — laboratorio de validación (Host B, máquina SEPARADA del host Phylax)
# ==============================================================================
# Copia este archivo a .env y ajústalo antes de ./deploy.sh.

# IP a la que se publican los puertos de los servicios vulnerables en Host B.
# 0.0.0.0 = todas las interfaces (correcto si Host B solo tiene la interfaz de
# la red aislada del laboratorio). Si Host B tiene varias interfaces de red
# (p. ej. una hacia el laboratorio y otra hacia internet para bajar imágenes),
# fija aquí la IP de la interfaz del laboratorio para no exponer nada más.
BIND_IP=0.0.0.0

# Credenciales de las bases de datos del laboratorio. Son intencionalmente
# simples (es un laboratorio con vulnerabilidades reales, no un sistema que
# proteger) pero deben poder cambiarse sin editar docker-compose.yml.
WP_DB_ROOT_PASSWORD=wplab-rootpass
WP_DB_PASSWORD=wplab-pass
PG_OLD_PASSWORD=pglab-pass
